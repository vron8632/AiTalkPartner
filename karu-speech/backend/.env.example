# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 生成随机密钥: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# 运行环境（生产环境设 False 并配置域名，逗号分隔）
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# MySQL 数据库
DB_NAME=karu_speech
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# 第三方服务（可选，不填则对应功能不可用）
DEEPSEEK_API_KEY=
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
